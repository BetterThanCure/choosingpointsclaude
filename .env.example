# Neon — Project Dashboard → Connection Details (use the pooled connection string)
DATABASE_URL=

# Neon Auth (Stack Auth) — Neon Dashboard → Auth tab → Enable, then
# Configuration → Keys
NEXT_PUBLIC_STACK_PROJECT_ID=
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=
# Server-only. Never expose to the client or commit a real value.
STACK_SECRET_SERVER_KEY=

# Vercel Blob — Vercel Project → Storage → Create Database → Blob
BLOB_READ_WRITE_TOKEN=

# Kéya (Anthropic API) — server-only
ANTHROPIC_API_KEY=

# Public URL of this deployment, used for auth redirects and metadata.
# Local dev:
NEXT_PUBLIC_APP_URL=http://localhost:3000
