# Neon — Project Dashboard → Connection Details (use the pooled connection string)
DATABASE_URL=

# Neon Auth (Managed Better Auth) — Neon Dashboard → this project → Auth tab
# → Configuration, copy the "Auth Base URL".
NEON_AUTH_BASE_URL=
# Server-only, min 32 characters. Generate with: openssl rand -base64 32
# Never expose to the client or commit a real value.
NEON_AUTH_COOKIE_SECRET=

# Vercel Blob — Vercel Project → Storage → Create Database → Blob
BLOB_READ_WRITE_TOKEN=

# Kéya (Anthropic API) — server-only
ANTHROPIC_API_KEY=

# Public URL of this deployment, used for auth redirects and metadata.
# Local dev:
NEXT_PUBLIC_APP_URL=http://localhost:3000
